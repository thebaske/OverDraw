<Window x:Class="OverDraw.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverDraw Settings"
        Width="380" SizeToContent="Height" MaxHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#FF2D2D30">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Color -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Pen Color" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Border x:Name="ColorSwatch" Width="32" Height="32" CornerRadius="4"
                            BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0"
                            Cursor="Hand" MouseLeftButtonUp="OnColorSwatchClick"/>
                    <TextBox x:Name="ColorHexBox" Width="90" Height="32" VerticalContentAlignment="Center"
                             FontSize="13" Background="#FF3E3E42" Foreground="#FFCCCCCC"
                             BorderBrush="#55FFFFFF" Padding="6,0"
                             TextChanged="OnColorHexChanged"/>
                </WrapPanel>
            </StackPanel>

            <!-- Thickness -->
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ThicknessLabel" Text="Thickness: 3" Margin="0,0,0,6"/>
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="OnThicknessChanged"/>
            </StackPanel>

            <!-- Fade Duration -->
            <StackPanel Grid.Row="4">
                <TextBlock x:Name="FadeLabel" Text="Fade: 2.0s" Margin="0,0,0,6"/>
                <Slider x:Name="FadeSlider" Minimum="0.5" Maximum="10" TickFrequency="0.5"
                        IsSnapToTickEnabled="True" ValueChanged="OnFadeChanged"/>
            </StackPanel>

            <!-- Modifier Key -->
            <StackPanel Grid.Row="6">
                <TextBlock Text="Hold key + Left Click to draw" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModifierCombo" Width="120" HorizontalAlignment="Left"
                          Height="28" FontSize="13"
                          Background="#FF3E3E42" Foreground="#FF111111"
                          SelectionChanged="OnModifierChanged">
                    <ComboBoxItem Content="Ctrl" />
                    <ComboBoxItem Content="Shift" />
                    <ComboBoxItem Content="Alt" />
                </ComboBox>
            </StackPanel>

            <!-- Stamps header -->
            <TextBlock x:Name="StampsHeader" Grid.Row="8" Text="Stamps (Ctrl + 1-0)" FontSize="14" FontWeight="SemiBold"/>

            <!-- Stamp slots -->
            <WrapPanel x:Name="StampSlotsPanel" Grid.Row="10" Orientation="Horizontal"/>

            <!-- Close button -->
            <Button Grid.Row="12" Content="Close" Width="80" Height="30"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick"
                    Background="#FF007ACC" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand"/>
        </Grid>
    </ScrollViewer>
</Window>
