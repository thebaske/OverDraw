<Window x:Class="OverDraw.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF2D2D30">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Color palette -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Palette" Margin="0,0,0,6"/>
            <WrapPanel x:Name="PalettePanel"/>
        </StackPanel>

        <!-- Recent colors -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Recent" Margin="0,0,0,6"/>
            <WrapPanel x:Name="RecentPanel"/>
        </StackPanel>

        <!-- RGB sliders -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="R"/>
            <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged"/>
            <TextBlock x:Name="LabelR" Grid.Row="0" Grid.Column="2" Text="0" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="G"/>
            <Slider x:Name="SliderG" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged"/>
            <TextBlock x:Name="LabelG" Grid.Row="2" Grid.Column="2" Text="0" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="B"/>
            <Slider x:Name="SliderB" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged"/>
            <TextBlock x:Name="LabelB" Grid.Row="4" Grid.Column="2" Text="0" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Preview + hex -->
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Border x:Name="PreviewSwatch" Width="40" Height="40" CornerRadius="4"
                    BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,12,0"/>
            <TextBox x:Name="HexBox" Width="100" Height="32" VerticalContentAlignment="Center"
                     FontSize="13" Background="#FF3E3E42" Foreground="#FFCCCCCC"
                     BorderBrush="#55FFFFFF" Padding="6,0"
                     TextChanged="OnHexChanged"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Height="28" Margin="0,0,8,0"
                    Click="OnOkClick"
                    Background="#FF007ACC" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand"/>
            <Button Content="Cancel" Width="70" Height="28"
                    Click="OnCancelClick"
                    Background="#FF555555" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
